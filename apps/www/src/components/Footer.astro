---
import Brand from "./Brand.astro";
---

<footer class="site-footer" data-motion-scene>
  <div class="container">
    <div class="footer-main">
      <div>
        <a href="/" class="brand-link" aria-label="pleasehold.dev home">
          <Brand />
        </a>
        <p>
          Waitlists. One API call.
          <br />
          Open source. Hosted or self-hosted.
        </p>
      </div>
      <nav aria-label="Footer navigation">
        <a href="https://app.pleasehold.dev">Dashboard ↗</a>
        <a href="https://app.pleasehold.dev/docs">API docs ↗</a>
        <a href="https://github.com/GoldenBerry-SO/pleasehold.dev">GitHub ↗</a>
        <a href="https://github.com/GoldenBerry-SO/pleasehold.dev#quick-start-docker">
          Self-host ↗
        </a>
      </nav>
    </div>
    <div class="footer-bottom">
      <div class="studio-signature">
        <a href="https://goldenberry.studio">A GoldenBerry Studio product ↗</a>
        <span>
          Made with{" "}
          <span class="studio-emoji" aria-hidden="true">
            <span class="studio-emoji-track">
              <span>🍇</span>
              <span>❤️</span>
              <span>🎧</span>
              <span>☕️</span>
              <span>🥐</span>
              <span>⌨️</span>
              <span>🌻</span>
              <span>🎙️</span>
              <span>🍇</span>
            </span>
          </span>
          <span class="studio-sr-only">care</span> in Berlin 🇪🇺
        </span>
      </div>
      <span class="mono">Open source · AGPL-3.0</span>
    </div>
  </div>
</footer>
