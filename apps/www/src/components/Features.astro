---
const features = [
  {
    icon: "{ }",
    title: "A form that feels like you.",
    description:
      "Email only, or name, company, and a message. Configure the fields you need and keep complete control of your frontend.",
  },
  {
    icon: "✓",
    title: "Real interest. Verified.",
    description:
      "Optional double opt-in, email deduplication, and queue positions built in. A useful list from the very first entry.",
  },
  {
    icon: "↗",
    title: "A workflow beyond signup.",
    description:
      "Search entries, track their status, take bulk actions, and export to CSV. Keep the conversation moving.",
  },
  {
    icon: "⌘",
    title: "Open from the source.",
    description:
      "AGPL-3.0 licensed. Inspect the code, contribute a fix, or run it on your own infrastructure with Docker Compose.",
  },
];
---

<section class="features-section">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The details, handled</p>
        <h2>
          Small surface.
          <br />
          Thoughtful underneath.
        </h2>
      </div>
      <p class="section-description">
        Everything around that first API call, built to make your next launch a
        little easier.
      </p>
    </div>
    <div class="notification-feature">
      <div>
        <span class="eyebrow">An entry lands. Your team knows.</span>
        <h3>
          Your signups,
          <br />
          where you work.
        </h3>
        <p>
          Send notifications to Slack, Discord, Telegram, email, or your own
          webhook. Every channel retries independently.
        </p>
        <div class="channel-list">
          <span>Slack</span>
          <span>Discord</span>
          <span>Telegram</span>
          <span>Email</span>
          <span>Webhooks</span>
        </div>
      </div>
      <div class="notification-visual" aria-label="Example signup notification">
        <span class="notification-route mono">
          POST /entries <span aria-hidden="true">──────→</span> #launch-feed
        </span>
        <div class="notification-card">
          <span class="notification-mark" aria-hidden="true">
            Ⅱ
          </span>
          <div>
            <strong>
              pleasehold <span>APP</span>
            </strong>
            <p>Someone’s waiting for Orbit.</p>
            <div class="notification-fields">
              <span>Email</span>
              <span>ada@example.com</span>
              <span>Position</span>
              <span>#42 on the list</span>
            </div>
            <span class="notification-footer">
              Example notification · Your next launch
            </span>
          </div>
        </div>
        <p class="notification-security mono">
          <span aria-hidden="true">✓</span> Signed webhooks · HMAC-SHA256
        </p>
      </div>
    </div>
    <div class="feature-grid">
      {features.map((feature) => (
        <article>
          <span class="feature-icon" aria-hidden="true">
            {feature.icon}
          </span>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
