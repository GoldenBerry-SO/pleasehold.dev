---
import { Code } from "astro:components";
const curl = `curl https://app.pleasehold.dev/api/v1/entries \\
  -X POST \\
  -H "Content-Type: application/json" \\
  -H "x-api-key: $PLEASEHOLD_API_KEY" \\
  -d '{"email": "ada@example.com"}'`;
const javascript = `// Run on your server
const response = await fetch(
  "https://app.pleasehold.dev/api/v1/entries",
  {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "x-api-key": process.env.PLEASEHOLD_API_KEY
    },
    body: JSON.stringify({ email: "ada@example.com" })
  }
);
const { data } = await response.json();`;
---

<section class="hero">
  <div class="hero-grid container">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="status-dot"></span> The API for your next launch
      </div>
      <h1>
        Waitlists.
        <br />
        <span>One API call.</span>
      </h1>
      <p class="hero-description">
        Your form. Your brand. Your next big thing.
        <br class="desktop-break" /> Collect early interest and demo requests
        with an API that fits the way you build.
      </p>
      <div class="hero-actions">
        <a class="button" href="https://app.pleasehold.dev/signup">
          Start building for free <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="https://app.pleasehold.dev/docs">
          Explore the API <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero-note">
        100 entries / month free <span aria-hidden="true">·</span> No credit
        card required
      </p>
    </div>
    <div class="hero-demo">
      <div class="code-window">
        <div class="window-bar">
          <span class="window-dots" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>One endpoint. Endless possibilities.</span>
          <span class="mono">↗</span>
        </div>
        <div class="code-toolbar">
          <div class="code-tabs" aria-label="Code language">
            <button
              class="code-tab"
              aria-pressed="true"
              aria-controls="snippet-curl"
              data-language="curl"
            >
              cURL
            </button>
            <button
              class="code-tab"
              aria-pressed="false"
              aria-controls="snippet-javascript"
              data-language="javascript"
            >
              Node.js
            </button>
          </div>
          <button class="copy-code" aria-label="Copy code example">
            Copy <span aria-hidden="true">⧉</span>
          </button>
        </div>
        <div class="code-content" id="snippet-curl">
          <Code code={curl} lang="bash" theme="github-dark" />
        </div>
        <div class="code-content" id="snippet-javascript" hidden>
          <Code code={javascript} lang="javascript" theme="github-dark" />
        </div>
        <div class="code-bottom">
          <span>
            <span class="method">POST</span> /api/v1/entries
          </span>
          <button
            class="preview-response"
            aria-expanded="false"
            aria-controls="example-response"
          >
            Preview response <span aria-hidden="true">↗</span>
          </button>
        </div>
        <div class="response-code" id="example-response" hidden>
          <span class="response-status">201 Created · Example response</span>
          <pre><code>{`{ "data": { "email": "ada@example.com", "position": 42 } }`}</code></pre>
        </div>
      </div>
      <div class="entry-ticket">
        <div class="ticket-icon" aria-hidden="true">
          ✓
        </div>
        <div>
          <span class="eyebrow">One more reason to ship</span>
          <strong>You’re on the list.</strong>
          <span class="ticket-caption">An example of your next signup.</span>
        </div>
        <span class="ticket-position">#0042</span>
      </div>
      <output id="code-feedback" class="sr-only" aria-live="polite"></output>
    </div>
  </div>
  <div class="container hero-footer">
    <span class="mono">Made for your stack</span>
    <div>
      <span>Next.js</span>
      <span>Astro</span>
      <span>Remix</span>
      <span>Laravel</span>
      <span>Anything that speaks HTTP</span>
    </div>
    <a href="https://github.com/GoldenBerry-SO/pleasehold.dev">
      <span aria-hidden="true">⌘</span> Open source, always ↗
    </a>
  </div>
</section>
<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(
    ".code-tab[data-language]",
  );
  let currentLanguage = "curl";
  for (const tab of tabs)
    tab.addEventListener("click", () => {
      currentLanguage = tab.dataset.language ?? "curl";
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute("aria-pressed", String(selected));
        const snippet = document.getElementById(
          `snippet-${other.dataset.language}`,
        );
        if (snippet) snippet.hidden = !selected;
      }
    });
  const copyButton = document.querySelector<HTMLButtonElement>(".copy-code");
  copyButton?.addEventListener("click", async () => {
    const feedback = document.getElementById("code-feedback");
    try {
      await navigator.clipboard.writeText(
        document.querySelector(`#snippet-${currentLanguage} pre`)
          ?.textContent ?? "",
      );
      copyButton.textContent = "Copied ✓";
      if (feedback) feedback.textContent = "Code example copied.";
    } catch {
      if (feedback)
        feedback.textContent =
          "Copy unavailable. Select and copy the code example.";
      copyButton.textContent = "Select code to copy";
    }
    setTimeout(() => {
      copyButton.textContent = "Copy ⧉";
    }, 2500);
  });
  const preview =
    document.querySelector<HTMLButtonElement>(".preview-response");
  preview?.addEventListener("click", () => {
    const response = document.getElementById("example-response");
    if (!response) return;
    response.hidden = !response.hidden;
    preview.setAttribute("aria-expanded", String(!response.hidden));
  });
</script>
