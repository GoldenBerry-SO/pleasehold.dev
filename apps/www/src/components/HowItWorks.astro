---
const steps = [
  {
    number: "01",
    title: "Make it yours.",
    text: "Create a waitlist or demo-request project. Choose your fields and generate a project-scoped API key.",
    code: "Project-scoped API key",
  },
  {
    number: "02",
    title: "Connect your form.",
    text: "Send a JSON payload from your server. Keep your frontend, your framework, and every pixel of your brand.",
    code: "POST /api/v1/entries",
  },
  {
    number: "03",
    title: "Meet your first users.",
    text: "See entries in your dashboard and get notified in the tools your team already uses.",
    code: "201 Created",
  },
];
---

<section class="steps-section container" id="developers">
  <div class="section-heading">
    <div>
      <p class="eyebrow">A small API. A shorter to-do list.</p>
      <h2>From idea to “you’re on the list.”</h2>
    </div>
    <a class="text-link" href="https://app.pleasehold.dev/docs">
      Read the API docs <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="steps-grid">
    {steps.map((step) => (
      <article>
        <span class="step-number">{step.number}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
        <code>{step.code}</code>
      </article>
    ))}
  </div>
</section>
