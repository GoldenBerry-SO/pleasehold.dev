---
const plans = [
  {
    name: "Free",
    price: "€0",
    period: "forever",
    description: "For the idea you can’t wait to ship.",
    cta: "Start building",
    href: "https://app.pleasehold.dev/signup",
    features: [
      "100 entries per month",
      "1 project",
      "Full API access",
      "All notification channels",
      "Default email templates",
      "Community support",
    ],
  },
  {
    name: "Pro",
    price: "€19",
    period: "every 3 months",
    description: "For the launch that’s picking up speed.",
    cta: "Get Pro",
    href: "https://app.pleasehold.dev/settings/billing",
    features: [
      "Unlimited entries and projects",
      "Everything in Free",
      "Custom branding and colors",
      "Custom email templates",
      "Remove the Please Hold badge",
      "Priority support",
    ],
  },
];
---

<section class="pricing-section container" id="pricing">
  <div class="section-heading centered">
    <p class="eyebrow">Room to start. Room to grow.</p>
    <h2>Your next idea starts free.</h2>
    <p>Simple plans for your first signup and everything after.</p>
  </div>
  <div class="pricing-grid">
    {plans.map((plan) => (
      <article
        class:list={["pricing-card", { "pricing-pro": plan.name === "Pro" }]}
      >
        <div class="pricing-name">
          <h3>{plan.name}</h3>
          {plan.name === "Pro" && <span>MORE ROOM TO BUILD</span>}
        </div>
        <p>{plan.description}</p>
        <div class="pricing-amount">
          <strong>{plan.price}</strong>
          <span>{plan.period}</span>
        </div>
        <a
          class:list={["button", plan.name === "Free" ? "button-outline" : ""]}
          href={plan.href}
        >
          {plan.cta}
          <span aria-hidden="true">↗</span>
        </a>
        <ul>
          {plan.features.map((feature) => (
            <li>
              <span aria-hidden="true">✓</span>
              {feature}
            </li>
          ))}
        </ul>
        {plan.name === "Pro" && (
          <p class="pricing-footnote">
            Billed quarterly. Cancel through your billing portal.
          </p>
        )}
      </article>
    ))}
  </div>
  <div class="self-host">
    <span class="self-host-icon" aria-hidden="true">
      ⌘
    </span>
    <div>
      <h3>Your infrastructure. Your rules.</h3>
      <p>
        Self-host for free with unlimited features. Docker Compose, ready when
        you are.
      </p>
    </div>
    <a
      class="text-link"
      href="https://github.com/GoldenBerry-SO/pleasehold.dev"
    >
      Get the source <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
